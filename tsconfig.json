{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "types": ["node"],
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noUncheckedIndexedAccess": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "playwright.config.ts",
        "tests/**/*.ts",
        "fixture/**/*.ts",
        "pages/**/*.ts",
        "data/**/*.ts",
        "services/**/*.ts"
    ]
}
